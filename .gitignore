# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

nextjs-lti-test

# dependencies
/node_modules
ws-server/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
drawBoard/dist

# misc
.DS_Store
.cursor/
.dev-pids
.creator-ai-chats/
*.pem
exported-logs/
# log/debug bundles must never be committed (any *-prod-logs.tar.gz, prod-*.tar.gz, etc.)
*.tar.gz

# Playwright browser binaries — install at build/dev time (npx playwright install),
# never commit platform-specific binaries (520MB+, and mac binaries are useless in Linux images)
.playwright-browsers/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
